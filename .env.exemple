PG_SCALABLE_WORKERS_DB=scalable-workers_db
PG_SCALABLE_WORKERS_USER=scalable-workers_user
PG_SCALABLE_WORKERS_PASSWORD=scalable-workers_password

PG_URL=postgres://scalable-workers_user:scalable-workers_password@localhost:5435/scalable-workers_db

REDIS_SW_HOST=localhost
REDIS_SW_PORT=6379
REDIS_SW_PASSWORD=scalable-workers_redis_password
