WORKER_PG_URL=postgres://scalable-workers_user:scalable-workers_password@postgres:5432/scalable-workers_db
WORKER_REDIS_SW_HOST=redis
WORKER_REDIS_SW_PORT=6379

VITE_APP_BACKEND_URL=http://localhost:3000
