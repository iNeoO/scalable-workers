{
	"name": "@sw/infra",
	"type": "module",
	"private": true,
	"scripts": {
		"lint": "biome check",
		"build": "rm -rf ./dist && bunx tsc -p ./tsconfig.build.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./libs": {
			"types": "./dist/libs/index.d.ts",
			"import": "./dist/libs/index.js",
			"default": "./dist/libs/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js",
			"default": "./dist/config/index.js"
		}
	},
	"dependencies": {
		"@sw/common": "workspace:*",
		"zod": "catalog:",
		"ioredis": "catalog:",
		"pino": "catalog:",
		"pino-pretty": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
