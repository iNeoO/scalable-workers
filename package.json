{
	"name": "@sw/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"build": "npx nx run-many -t build --all",
		"worker:dev": "dotenv -e .env -- bun run --filter @sw/task-worker dev",
		"backend:dev": "dotenv -e .env -- bun run --filter @sw/backend dev",
		"frontend:dev": "dotenv -e .env -- bun run --filter @sw/frontend dev",
		"dev": "dotenv -e .env -- bun run --parallel worker:dev backend:dev frontend:dev",
		"db:generate": "dotenv -e .env -- bun run --filter @sw/drizzle generate",
		"db:push": "dotenv -e .env -- bun run --filter @sw/drizzle push",
		"db:pull": "dotenv -e .env -- bun run --filter @sw/drizzle pull",
		"db:check": "dotenv -e .env -- bun run --filter @sw/drizzle check",
		"db:up": "dotenv -e .env -- bun run --filter @sw/drizzle up",
		"db:studio": "dotenv -e .env -- bun run --filter @sw/drizzle studio",
		"db:migrate": "dotenv -e .env -- bun run --filter @sw/drizzle migrate",
		"scripts:reset": "dotenv -e .env -- bun run --filter @sw/scripts reset",
		"lint": "nx run-many -t lint --all"
	},
	"private": true,
	"devDependencies": {
		"@nx/js": "22.7.1",
		"@swc-node/register": "~1.11.1",
		"@swc/core": "~1.15.5",
		"@swc/helpers": "~0.5.18",
		"dotenv-cli": "^11.0.0",
		"nx": "22.7.1",
		"tslib": "^2.3.0",
		"typescript": "~5.9.2"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"catalog": {
		"zod": "^4.4.3",
		"elysia": "latest",
		"amqplib": "^2.0.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-kit": "^0.31.10",
		"pg": "^8.20.0",
		"dotenv": "^17.4.2",
		"ioredis": "^5.10.1",
		"pino": "^10.3.1",
		"@biomejs/biome": "^2.4.15",
		"pino-pretty": "^13.1.3",
		"@types/bun": "latest",
		"@types/pg": "^8.20.0",
		"tsx": "^4.21.0"
	}
}
